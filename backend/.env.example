# ===========================================
# PORTFOLIO BACKEND - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
# Get these from your Supabase project settings -> API
# Go to: https://app.supabase.com -> Your Project -> Settings -> API

# Your Supabase project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase service role key (NOT the anon key!)
# Found in Settings -> API -> Project API keys -> service_role
# WARNING: Keep this secret! Never expose in frontend code
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Secret code for password reset (change this!)
PASSWORD_RESET_SECRET=41534153

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
# For contact form notifications and replies
# Gmail: Use App Password (not regular password)
# https://support.google.com/accounts/answer/185833

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Portfolio <your_email@gmail.com>

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGIN=http://localhost:5500

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FILE UPLOAD LIMITS
# ===========================================
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Create a Supabase account at https://supabase.com
# 2. Create a new project
# 3. Go to SQL Editor and run the supabase_schema.sql file
# 4. Copy SUPABASE_URL and SUPABASE_SERVICE_KEY from Settings -> API
# 5. Update this file with your credentials
# 6. Run: npm install
# 7. Run: npm run dev
